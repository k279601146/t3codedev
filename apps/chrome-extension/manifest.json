{
  "manifest_version": 3,
  "name": "Bahew Chrome Extension",
  "description": "Connect Chrome to Bahew browser_use_external.",
  "version": "0.0.23",
  "permissions": ["activeTab", "scripting", "storage", "tabs", "tabGroups"],
  "host_permissions": ["http://127.0.0.1/*", "http://localhost/*"],
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Bahew",
    "default_popup": "src/popup.html"
  }
}
