# T3 Code commercial auth integration
#
# Visible local config for dev runner. Copy this file to .env and edit values.

# dev2 Web root. Do not append /ide/auth/authorize.
MYIDE_WEB_AUTH_BASE_URL=http://localhost:3001/

# dev2 billing proxy root. Keep /v1 for OpenAI-compatible model calls.
MYIDE_GATEWAY_BASE_URL=http://localhost:8000/v1

# Bahew desktop application version. Edit this to change the version for dev and build.
T3CODE_DESKTOP_VERSION=0.0.23

